<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题 -->
    <SolidColorBrush x:Key="Window.Background" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Panel.Background" Color="#252526"/>
    <SolidColorBrush x:Key="Panel.BackgroundAlt" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Border.Color" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Accent" Color="#007ACC"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#1F8AD2"/>
    <SolidColorBrush x:Key="Item.Hover" Color="#3E3E42"/>
    <SolidColorBrush x:Key="Item.Selected" Color="#094771"/>
    <SolidColorBrush x:Key="Editor.Background" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Editor.Foreground" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Editor.LineHighlight" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Editor.Selection" Color="#264F78"/>
    <SolidColorBrush x:Key="Editor.LineNumbers" Color="#858585"/>
    <SolidColorBrush x:Key="Marker.Light" Color="#5A5A50"/>
    <SolidColorBrush x:Key="Match.Background" Color="#515C2A"/>
    <SolidColorBrush x:Key="Match.Current" Color="#9E6A03"/>
    <SolidColorBrush x:Key="Flash.Background" Color="#264F78"/>
    <SolidColorBrush x:Key="StatusBar.Background" Color="#007ACC"/>
    <SolidColorBrush x:Key="StatusBar.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabBar.Background" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Warning" Color="#E5C07B"/>
    <SolidColorBrush x:Key="Error" Color="#F14C4C"/>

    <!-- 系统色覆盖：菜单/弹出层/输入控件跟随深色主题 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#094771"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9A9A9A"/>
</ResourceDictionary>
