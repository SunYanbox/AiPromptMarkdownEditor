<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题 -->
    <SolidColorBrush x:Key="Window.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Panel.BackgroundAlt" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Border.Color" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="Accent" Color="#007ACC"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#1F8AD2"/>
    <SolidColorBrush x:Key="Item.Hover" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Item.Selected" Color="#CDE6F7"/>
    <SolidColorBrush x:Key="Editor.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Editor.Foreground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Editor.LineHighlight" Color="#F2F6FA"/>
    <SolidColorBrush x:Key="Editor.Selection" Color="#ADD6FF"/>
    <SolidColorBrush x:Key="Editor.LineNumbers" Color="#909090"/>
    <SolidColorBrush x:Key="Marker.Light" Color="#B0B0A8"/>
    <SolidColorBrush x:Key="Match.Background" Color="#D7E8B5"/>
    <SolidColorBrush x:Key="Match.Current" Color="#F8C777"/>
    <SolidColorBrush x:Key="Flash.Background" Color="#BDD8F2"/>
    <SolidColorBrush x:Key="StatusBar.Background" Color="#007ACC"/>
    <SolidColorBrush x:Key="StatusBar.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabBar.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Warning" Color="#9A6700"/>
    <SolidColorBrush x:Key="Error" Color="#C43131"/>

    <!-- 系统色覆盖：菜单/弹出层/输入控件跟随亮色主题 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6A6A6A"/>
</ResourceDictionary>
