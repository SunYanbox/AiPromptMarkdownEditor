<Window x:Class="PromptEditor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Panel.Background}">
    <StackPanel Margin="16">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="字体：" VerticalAlignment="Center"/>
            <ComboBox x:Name="FontBox" Grid.Column="1" Margin="4"/>

            <TextBlock Text="字号：" Grid.Row="1" VerticalAlignment="Center"/>
            <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Margin="4"/>

            <TextBlock Text="Tab 宽度：" Grid.Row="2" VerticalAlignment="Center"/>
            <TextBox x:Name="TabSizeBox" Grid.Row="2" Grid.Column="1" Margin="4"/>

            <CheckBox x:Name="TabCharCheck" Content="Tab 键插入制表符（默认插入空格）" Grid.Row="3" Grid.Column="1" Margin="4" VerticalAlignment="Center"/>

            <CheckBox x:Name="WrapCheck" Content="软换行（默认关闭，长行横向滚动）" Grid.Row="4" Grid.Column="1" Margin="4" VerticalAlignment="Center"/>

            <CheckBox x:Name="LineNumbersCheck" Content="显示行号" Grid.Row="5" Grid.Column="1" Margin="4" VerticalAlignment="Center"/>

            <TextBlock Text="默认行尾格式：" Grid.Row="6" VerticalAlignment="Center"/>
            <ComboBox x:Name="EolBox" Grid.Row="6" Grid.Column="1" Margin="4">
                <ComboBoxItem Content="LF"/>
                <ComboBoxItem Content="CRLF"/>
                <ComboBoxItem Content="CR"/>
            </ComboBox>

            <TextBlock Text="主题：" Grid.Row="7" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeBox" Grid.Row="7" Grid.Column="1" Margin="4">
                <ComboBoxItem Content="深色"/>
                <ComboBoxItem Content="浅色"/>
            </ComboBox>
        </Grid>
        <UniformGrid Columns="2" Margin="0,10,0,0">
            <Button Content="确定" Click="OnOk" Margin="0,0,4,0" IsDefault="True"/>
            <Button Content="取消" Click="OnCancel" Margin="4,0,0,0" IsCancel="True"/>
        </UniformGrid>
    </StackPanel>
</Window>
