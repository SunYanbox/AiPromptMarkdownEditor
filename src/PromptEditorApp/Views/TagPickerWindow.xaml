<Window x:Class="PromptEditor.Views.TagPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更多标签…" Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Panel.Background}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="回车或双击应用包裹；" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource Text.Secondary}"/>
            <Button Content="标签库管理…" Click="OnOpenTagLibrary" Padding="10,3"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="过滤：" VerticalAlignment="Center"/>
            <TextBox x:Name="FilterBox" Margin="6,0,0,0"
                     TextChanged="OnFilterChanged" PreviewKeyDown="OnKeyDown"/>
        </DockPanel>
        <ListBox x:Name="List" PreviewMouseDoubleClick="OnDoubleClick" PreviewKeyDown="OnKeyDown"/>
    </DockPanel>
</Window>
