<Window x:Class="PromptEditor.Views.TableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建表格" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Panel.Background}">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="行数（不含表头）：" VerticalAlignment="Center"/>
            <TextBox x:Name="RowsBox" Grid.Column="1" Text="3" Margin="4,4,12,4"/>
            <TextBlock Text="列数：" Grid.Column="2" VerticalAlignment="Center"/>
            <TextBox x:Name="ColsBox" Grid.Column="3" Text="3" Margin="4"/>
            <TextBlock Text="表头（逗号分隔，可留空）：" Grid.Row="1" VerticalAlignment="Center"/>
            <TextBox x:Name="HeaderBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="列1, 列2, 列3" Margin="4"/>
        </Grid>
        <UniformGrid Columns="2" Margin="0,12,0,0">
            <Button Content="确定" Click="OnOk" Margin="0,0,4,0" IsDefault="True"/>
            <Button Content="取消" Click="OnCancel" Margin="4,0,0,0" IsCancel="True"/>
        </UniformGrid>
    </StackPanel>
</Window>
