<Window x:Class="PromptEditor.Views.QuickJumpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速跳转 (Ctrl+P)" Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Panel.Background}">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Bottom" Text="输入标题/标签模糊匹配；输入 :数字 跳转指定行；回车跳转，Esc 关闭。"
                   Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                 TextChanged="OnFilterChanged"
                 PreviewKeyDown="OnKeyDown"/>
        <ListBox x:Name="ResultList" PreviewMouseDoubleClick="OnDoubleClick"
                 PreviewKeyDown="OnKeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LineDisplay}"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
